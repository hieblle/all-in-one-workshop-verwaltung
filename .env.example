# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgres://workshop:workshop@localhost:5432/workshop_hub

# Für docker-compose (Coolify setzt diese Werte als Secrets)
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workshop_hub

# --- Auth (NextAuth v5) ----------------------------------------------------
# Generieren mit: npx auth secret
AUTH_SECRET=
# Öffentliche URL der App (Produktion: https://hub.dbrains.academy)
AUTH_URL=http://localhost:3000

# --- Notion-Import (einmalig, Phase 1) --------------------------------------
# Interne Integration unter notion.so/my-integrations anlegen und die
# "Workshop Liste"-Datenbank für die Integration freigeben.
NOTION_API_KEY=
NOTION_WORKSHOP_DB_ID=

# Entra ID App-Registrierung (internes Team, SSO)
# WICHTIG: Issuer MUSS tenant-spezifisch bleiben (niemals /common oder
# /consumers) — sonst könnten fremde Tenants Team-Konten per E-Mail kapern.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Optional: Tenant-ID explizit (sonst aus dem Issuer abgeleitet) — Team-Login
# wird nur für Konten aus diesem Mandanten akzeptiert.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# --- Hub (SPEC §5–§8) -------------------------------------------------------
# Kalender-Organisator und Fallback-Empfänger für Team-Erinnerungen
HUB_SERVICE_EMAIL=service@dbrains.academy
# Absender aller Hub-Mails (eigenes freigegebenes Postfach, Adresse noch offen)
HUB_ABSENDER_EMAIL=trainer@dbrains.academy
# Test-Login (MVP). Im Dev-Modus automatisch an; auf einem Server nur hinter
# dem Coolify-Passwortschutz auf true setzen (Stufe 2).
HUB_TEST_LOGIN=
