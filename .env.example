# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgres://workshop:workshop@localhost:5432/workshop_hub

# Für docker-compose (Coolify setzt diese Werte als Secrets)
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workshop_hub

# --- Auth (NextAuth v5) ----------------------------------------------------
# Generieren mit: npx auth secret
AUTH_SECRET=
# Öffentliche URL der App (Produktion: https://hub.dbrains.academy)
AUTH_URL=http://localhost:3000

# Entra ID App-Registrierung (internes Team, SSO)
# WICHTIG: Issuer MUSS tenant-spezifisch bleiben (niemals /common oder
# /consumers) — sonst könnten fremde Tenants Team-Konten per E-Mail kapern.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
